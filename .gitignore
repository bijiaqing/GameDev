
# executables
gamedev

# build and runtime outputs
/obj/
/out/

# local experiments
/lab/

# unpublished model configurations; retain published fiducial models
/mod/*
!/mod/*_fiducial/

# unpublished development notes; retain maintained public guides
/doc/*
!/doc/*_numeric.md
!/doc/*_testset.md
!/doc/README.md

# generated validation artifacts
/val/logs/
/val/temp/
/val/main/coagulation/**/seed_*.json
/val/main/swarm_diffusion/outputs
/val/main/swarm_drift/outputs
/val/main/swarm_orbit/outputs

# Python caches
__pycache__/
*.py[cod]

# Jupyter Notebooks
*.ipynb
*.ipynb_checkpoints

# OS metadata
.DS_Store
