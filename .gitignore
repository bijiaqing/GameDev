# executables
gamedev

# build and runtime outputs
/obj/
/out/

# local experiments
/lab/

# local model configurations; retain published fiducial models
/mod/*
!/mod/*_fiducial/

# local documentation; retain maintained public guides
/doc/*
!/doc/*_numeric.md
!/doc/*_testset.md
!/doc/README.md

# generated QAV artifacts
/qav/logs/
qav/*/swarm/test_knn/knn_*
!qav/*/swarm/test_knn/knn_*.*
qav/*/swarm/test_knn/production_test_collision_*
qav/*/swarm/test_knn/.*_k_*

# Python caches
__pycache__/
*.py[cod]

# OS metadata
.DS_Store