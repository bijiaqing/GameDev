
# executables
gamedev

# build and runtime outputs
/obj/
/out/

# local experiments
/lab/

# unpublished model configurations; retain published fiducial models
/mod/*
!/mod/*_fiducial/

# unpublished development notes; retain maintained public guides
/doc/*
!/doc/*_numeric.md
!/doc/*_testset.md
!/doc/README.md

# generated validation artifacts
/val/*.json
/val/paper/coagulation/**/seed_*.json
/val/paper/swarm_diffusion/out
/val/paper/swarm_drift/out
/val/paper/swarm_orbit/out

# Python caches
__pycache__/
*.py[cod]

# Jupyter Notebooks
*.ipynb
*.ipynb_checkpoints

# OS metadata
.DS_Store

# Representation-local validation artifacts
/val/fluid/out/
/val/fluid/obj/
/val/swarm/out/
/val/swarm/obj/

/val/paper/**/obj/
